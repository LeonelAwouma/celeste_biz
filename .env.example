# Céleste Biz — variables d'environnement (modèle, SANS valeurs secrètes).
# Copier en .env.local pour le développement. Ne jamais commiter .env*.

# --- Supabase (Phase 2) ---
# Valeurs publiques, exposées au navigateur (protégées par RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé de service : serveur uniquement. Ne JAMAIS préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application ---
# URL publique de l'application (domaine réel à choisir plus tard).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Feature flags (désactivés par défaut) ---
FEATURE_FISCAL_INVOICE_ISSUE=false
FEATURE_ONLINE_PAYMENTS=false
FEATURE_WHATSAPP_API=false
FEATURE_OFFLINE_DRAFTS=false
