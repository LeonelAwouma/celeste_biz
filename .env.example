# Céleste Biz — variables d'environnement (modèle, SANS valeurs secrètes).
# Copier en .env.local pour le développement. Ne jamais commiter .env*.
# En local, `npx supabase start` (ou `npx supabase status`) affiche les valeurs.

# --- Supabase ---
# Valeurs publiques, exposées au navigateur (protégées par RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète : serveur uniquement, jamais préfixée NEXT_PUBLIC_.
# Non utilisée par l'application à ce stade.
SUPABASE_SECRET_KEY=

# --- Application ---
# URL publique de l'application (liens des e-mails ; domaine réel à choisir).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Feature flags (désactivés par défaut) ---
FEATURE_FISCAL_INVOICE_ISSUE=false
FEATURE_ONLINE_PAYMENTS=false
FEATURE_WHATSAPP_API=false
FEATURE_OFFLINE_DRAFTS=false
